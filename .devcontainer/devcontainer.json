{
  "image": "mcr.microsoft.com/azterraform:latest",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--init",
    "--network=host"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "features": {
    "./features/local_provider_dev": {}
  },
  "postCreateCommand": "sh .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "[makefile]": {
          "editor.insertSpaces": false,
          "editor.detectIndentation": false
        }
      },
      "extensions": [
        "hashicorp.terraform",
        "golang.Go",
        "GitHub.copilot",
        "DavidAnson.vscode-markdownlint",
        "GitHub.vscode-github-actions",
        "ms-vscode.makefile-tools",
        "GitHub.copilot-chat",
        "GitHub.vscode-codeql"
      ]
    }
  },
  "containerEnv": {
    "TF_LOG": "ERROR",
    "TF_CLI_CONFIG_FILE": "/workspaces/terraform-provider-power-platform/.terraformrc",
    "POWER_PLATFORM_USE_CLI": "true",
    "ARM_USE_CLI": "true",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    // Cleared so each go binary resolves its own GOROOT. The base image pins GOROOT to
    // its Go install, which the newer toolchain that go.mod requires then inherits,
    // producing "compile: version ... does not match go tool version" on every build.
    "GOROOT": ""
  }
}
